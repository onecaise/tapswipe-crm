# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json

# supabase cli scratch
supabase/.temp/
supabase/.branches/

# playwright e2e
#
# .auth holds real session cookies for the fixture personas, written by
# e2e/auth.setup.ts. Local throwaway accounts, but a session token is a session
# token and none of these belong in git.
/e2e/.auth/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
